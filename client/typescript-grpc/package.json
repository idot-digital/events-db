{
  "name": "@idot-digital/eventsdb-grpc-client",
  "version": "0.0.1",
  "description": "TypeScript gRPC client for EventsDB",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run copy-proto && npm run generate && tsc",
    "generate": "npx protoc --ts_proto_out=./ --proto_path=./ ./gen/eventsdb.proto",
    "copy-proto": "mkdir -p gen && cp ../../eventsdb.proto ./gen/",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.8",
    "@grpc/proto-loader": "^0.7.10",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "ts-proto": "^1.170.0",
    "typescript": "^5.3.3"
  }
}
